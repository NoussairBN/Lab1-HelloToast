<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="17dp"
    android:background="#0A0A0A"> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Tentatives Brute-Force Bloquées"
    android:textColor="#00FF00"
    android:textSize="18sp"
    android:textStyle="bold"
    android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tv_blocked_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#00FF00"
        android:textSize="56sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_network_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analyser le trafic réseau"
        android:backgroundTint="#1A1A1A"
        android:textColor="#00FF00"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_simulate_attack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Simuler une attaque SSH"
        android:backgroundTint="#8B0000"
        android:textColor="#FFFFFF" />

</LinearLayout>